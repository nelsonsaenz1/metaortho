# ============================================================================
# MetaOrtho environment variables — copy to .env.local and fill in.
# ============================================================================

# ---- Supabase ---------------------------------------------------------------
# Public project URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon public key. Safe to expose — RLS policies enforce access.
# Supabase Studio → Project Settings → API → Project API keys → `anon` `public`
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. SERVER ONLY. Bypasses RLS. NEVER expose to the browser.
# Supabase Studio → Project Settings → API → Project API keys → `service_role` `secret`
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Resend (transactional email) -------------------------------------------
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Resend audience id — every waitlist signup is mirrored here so broadcasts
# can reach them. Resend → Audiences → (audience) → Settings.
RESEND_AUDIENCE_ID=

# From address + display name for the waitlist welcome email.
# Must be on a domain you have verified in Resend. See README for DNS setup.
WAITLIST_FROM_EMAIL=hello@metaortho.com
WAITLIST_FROM_NAME=Dr. Nelson Saenz

# Physical mailing address. Required by CAN-SPAM; appears in email footer.
WAITLIST_MAILING_ADDR=1234 Example St, Memphis, TN 38103

# ---- Customer.io (mass marketing) -------------------------------------------
# Track API credentials — used by app/api/waitlist/route.ts to identify every
# new signup in Customer.io alongside the Resend audience sync.
# Customer.io → Account Settings → API Credentials.
CUSTOMER_IO_SITE_ID=
CUSTOMER_IO_TRACK_API_KEY=

# App API key — needed for sending broadcasts/segments/transactional via API.
# Same page → "App API Keys" → Create. Not used by the waitlist route today;
# scripts/backfill-customerio.ts and any future broadcast tooling will read it.
CUSTOMER_IO_APP_API_KEY=

# Region — "us" or "eu". Picks api/track host. Defaults to "us" if unset.
CUSTOMER_IO_REGION=us

# ---- Slack ------------------------------------------------------------------
# Used by the Supabase edge function (waitlist-notify) to post new-signup
# notifications. Create at https://api.slack.com/apps → Incoming Webhooks.
# NOTE: In production this value is set on the Supabase Edge Function env,
# NOT in Vercel. It lives here only so local function development can use it.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Shared secret that authenticates the Supabase Database Webhook calling the
# waitlist-notify edge function. Set the SAME value on the function env AND as
# an `X-Webhook-Secret` header in the webhook config (Database → Webhooks). If
# unset, the function falls back to verifying the Authorization: Bearer
# <SERVICE_ROLE_KEY> header. Generate one with: openssl rand -hex 32
# Like SLACK_WEBHOOK_URL, this lives on the Supabase Edge Function env, not Vercel.
WAITLIST_NOTIFY_SECRET=

# ---- Assessment / GLP-1 Management Profile quiz -----------------------------
# Where the Profile's booking CTA points for Candidate / Strong-candidate
# results in licensed states. Set this to the Healthie scheduling URL once the
# practice is live. If unset, the CTA falls back to /api -> /book (lead capture)
# so no booking link is ever broken during the pre-launch phase.
NEXT_PUBLIC_BOOKING_URL=

# The assessment capture route (app/api/assessment/route.ts) writes every
# completed quiz to the `assessment_submissions` table (migration 0003) and,
# with marketing consent, mirrors the contact into the Resend audience +
# Customer.io using the credentials already configured above. No extra env vars
# are required for capture.
#
# NOT YET WIRED (clean integration stubs — see route.ts TODOs):
#   - Profile email:  transactional send of the rendered Profile via Resend.
#   - Healthie:       embedded booking flow (uses NEXT_PUBLIC_BOOKING_URL today).
#   - HUBSPOT_*:      CRM contact + deal sync, if HubSpot becomes the CRM.

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://metaortho.com
