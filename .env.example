# ============================================================================
# MetaOrtho environment variables — copy to .env.local and fill in.
# ============================================================================

# ---- Supabase ---------------------------------------------------------------
# Public project URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon public key. Safe to expose — RLS policies enforce access.
# Supabase Studio → Project Settings → API → Project API keys → `anon` `public`
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. SERVER ONLY. Bypasses RLS. NEVER expose to the browser.
# Supabase Studio → Project Settings → API → Project API keys → `service_role` `secret`
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Resend (email) ---------------------------------------------------------
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# From address + display name for the waitlist welcome email.
# Must be on a domain you have verified in Resend. See README for DNS setup.
WAITLIST_FROM_EMAIL=hello@metaortho.org
WAITLIST_FROM_NAME=Dr. Nelson Saenz

# Physical mailing address. Required by CAN-SPAM; appears in email footer.
WAITLIST_MAILING_ADDR=1234 Example St, Memphis, TN 38103

# ---- Slack ------------------------------------------------------------------
# Used by the Supabase edge function (waitlist-notify) to post new-signup
# notifications. Create at https://api.slack.com/apps → Incoming Webhooks.
# NOTE: In production this value is set on the Supabase Edge Function env,
# NOT in Vercel. It lives here only so local function development can use it.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://metaortho.org
